<%- include('layout', {
    title: 'Państwa i stolice',
    body: `
      <h2>Lista państw</h2>
      <ul>
        ${countries.map(c => `<li><strong>${c.name}</strong> — ${c.capital}</li>`).join('')}
      </ul>
  
      <h3>Dodaj nowe państwo</h3>
      <form action="/add" method="POST">
        <label>Nazwa państwa:</label><br>
        <input type="text" name="name" required><br><br>
        <label>Stolica:</label><br>
        <input type="text" name="capital" required><br><br>
        <button type="submit">Dodaj</button>
      </form>
    `
  }) %>
  