<!DOCTYPE html>
<html>
<head>
<title>Dodaj skuter</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="shortcut icon" href="skuter.png" type="image/x-icon">
</head>

<body>

<div class="container">

<h1>Dodaj skuter</h1>

<form method="POST">

<label>Marka</label>
<input name="brand" placeholder="np. Aprilia" required>

<label>Model</label>
<input name="model" placeholder="np. SR 50" required>

<label>Pojemność silnika</label>
<input name="engine" placeholder="np. 50cc">

<label>Rok produkcji</label>
<input name="year" placeholder="np. 2020">

<label>Opis</label>
<textarea name="description" placeholder="Opis skutera"></textarea>

<button>Dodaj skuter</button>

</form>

</div>

</body>
</html>