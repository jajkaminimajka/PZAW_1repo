<!DOCTYPE html>
<html lang="pl">
<head><%- include('partials/head', { pageTitle: 'Logowanie' }) %></head>
<body>
<%- include('partials/navbar') %>
<main class="page-center">
  <div class="card">
    <h1 class="card__title">Logowanie</h1>
    <%- include('partials/flash') %>

    <% if (errors && errors.length) { %>
      <ul class="error-list">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form method="POST" action="/login" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="username">Nazwa użytkownika</label>
        <input
          type="text" id="username" name="username"
          value="<%= (old && old.username) || '' %>"
          autocomplete="username" required>
      </div>

      <div class="form-group">
        <label for="password">Hasło</label>
        <input type="password" id="password" name="password"
          autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn--primary btn--full">Zaloguj się</button>
    </form>

    <p class="card__footer-text">
      Nie masz konta? <a href="/register">Zarejestruj się</a>
    </p>
  </div>
</main>
</body>
</html>
